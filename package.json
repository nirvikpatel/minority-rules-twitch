{
  "name": "minority-rules",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && vite build --config extension/vite.config.ts && node scripts/package-extension.mjs",
    "preview": "wrangler dev",
    "test": "vitest run",
    "deploy": "tsc --noEmit && vite build && vite build --config extension/vite.config.ts && node scripts/package-extension.mjs && wrangler deploy",
    "check:deploy": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fflate": "^0.8.2",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.45.0"
  }
}
